{
  "name": "arclight_1_21_11_remote_real_boat_mount_and_move",
  "status": "PARENT_HARNESS_REQUIRED",
  "tags": [
    "arclight-1.21.11",
    "entities",
    "vehicle",
    "boat",
    "external-server",
    "real-client-action",
    "parent-harness-required"
  ],
  "requires": {
    "loaders": [
      "fabric",
      "neoforge"
    ],
    "sides": [
      "client"
    ]
  },
  "notes": [
    "前置条件由父 harness 建立：受控 OP 玩家位于 (34.5,81,32.5) 且未乘坐实体。夹具 setup 可以使用服务器命令清理水槽、放水和生成唯一 tag=minecraft_mcp_arclight_boat 的 oak_boat；测试动作不得使用 /ride、/mount 或命令强制成为乘客。",
    "当前 MCP 没有 mc.client.entity.interact/entity.mount：客户端可验证的真实 mount 输入只能通过绑定的原生 USE 键（鼠标右键）配合 mc.client.player.look_at；若该键不等于 key.mouse.right，或测试客户端不能把该键绑定到 use，父 harness 必须报告 NOT_IMPLEMENTED，不得用 /ride 代替。",
    "船移动必须通过真实客户端键盘前进输入 mc.client.keyboard.hold(W)；mc.client.movement.waypoints 直接移动 LocalPlayer，不是本船场景的可接受替代。",
    "普通 JSON 步骤可以证明 mount/move 的客户端可见后果和服务器 boat 实体存在；父 harness 仍负责在 finally 清理生成的 tag。"
  ],
  "parentAssertions": {
    "preAction": [
      "执行点击前，mc.client.vehicle.state 必须 isPassenger=false。",
      "父 harness 必须确认当前 use 键绑定可由 mc.client.keyboard.press 的 key.mouse.right 触发；否则返回 NOT_IMPLEMENTED: no registered entity-interact/mount tool and USE binding is unavailable。"
    ],
    "mountAndMove": [
      "mc.client.keyboard.press(key.mouse.right) 是唯一可接受的 mount 输入；不得以 mc.server.command.run /ride、/mount、tp 或插件 API 达成 isPassenger=true。",
      "点击后 mc.client.vehicle.state 必须 isPassenger=true 且 vehicle=minecraft:oak_boat。",
      "mc.client.keyboard.hold(W,20) 后 mc.client.vehicle.state 仍为 isPassenger=true/vehicle=minecraft:oak_boat；其 z 必须相对 mount 后状态增加至少 0.5。",
      "父 harness 还必须在动作后调用 mc.server.entity.query(type=minecraft:oak_boat, box=fixture)，要求 total=1，并确认返回 boat z 相对点击前记录增加至少 0.5。"
    ],
    "forbidden": [
      "命令 /ride、/mount、tp、teleport、spreadplayers，或任何服务器/插件直接设置 passenger/vehicle 状态。",
      "mc.client.movement.waypoints 作为船移动证据。",
      "只因 keyboard.press 返回 status=pressed 就声称 mount 成功。"
    ]
  },
  "steps": [
    {
      "id": "confirm_remote_server_mcp",
      "tool": "mc.remote.call",
      "args": {
        "tool": "mc.server.state",
        "arguments": {},
        "timeoutMs": 30000
      },
      "expect": {
        "result.running": true,
        "result.dedicated": true
      }
    },
    {
      "id": "clear_only_boat_fixture",
      "tool": "mc.remote.call",
      "args": {
        "tool": "mc.server.command.run",
        "arguments": {
          "command": "fill 30 79 30 38 82 42 minecraft:air"
        },
        "timeoutMs": 30000
      },
      "expect": {
        "result.status": "succeeded",
        "result.command": "fill 30 79 30 38 82 42 minecraft:air",
        "result.success": true,
        "result.completed": true
      }
    },
    {
      "id": "create_water_lane",
      "tool": "mc.remote.call",
      "args": {
        "tool": "mc.server.command.run",
        "arguments": {
          "command": "fill 33 80 33 35 80 41 minecraft:water"
        },
        "timeoutMs": 30000
      },
      "expect": {
        "result.status": "succeeded",
        "result.command": "fill 33 80 33 35 80 41 minecraft:water",
        "result.success": true,
        "result.completed": true
      }
    },
    {
      "id": "spawn_the_single_tagged_boat",
      "tool": "mc.remote.call",
      "args": {
        "tool": "mc.server.command.run",
        "arguments": {
          "command": "summon minecraft:oak_boat 34.5 81 35.5 {Tags:[\"minecraft_mcp_arclight_boat\"],Rotation:[0f,0f]}"
        },
        "timeoutMs": 30000
      },
      "expect": {
        "result.status": "succeeded",
        "result.command": "summon minecraft:oak_boat 34.5 81 35.5 {Tags:[\"minecraft_mcp_arclight_boat\"],Rotation:[0f,0f]}",
        "result.success": true,
        "result.completed": true
      }
    },
    {
      "id": "sync_after_fixture_setup",
      "tool": "mc.client.connection.sync",
      "args": {
        "timeoutMs": 30000
      },
      "expect": {
        "result.status": "synced"
      }
    },
    {
      "id": "observe_the_single_authoritative_boat_before_mount",
      "tool": "mc.remote.call",
      "args": {
        "tool": "mc.server.entity.query",
        "arguments": {
          "type": "minecraft:oak_boat",
          "from": {
            "x": 30,
            "y": 79,
            "z": 30
          },
          "to": {
            "x": 38,
            "y": 84,
            "z": 42
          },
          "limit": 4
        },
        "timeoutMs": 30000
      },
      "expect": {
        "result.type": "minecraft:oak_boat",
        "result.total": 1,
        "result.returned": 1
      }
    },
    {
      "id": "not_a_passenger_before_real_interaction",
      "tool": "mc.client.vehicle.state",
      "args": {},
      "expect": {
        "result.inWorld": true,
        "result.isPassenger": false
      }
    },
    {
      "id": "look_at_the_tagged_boat",
      "tool": "mc.client.player.look_at",
      "args": {
        "x": 34.5,
        "y": 81.5,
        "z": 35.5
      },
      "expect": {
        "result.status": "looked_at",
        "result.x": 34.5,
        "result.y": 81.5,
        "result.z": 35.5
      }
    },
    {
      "id": "mount_with_real_use_key",
      "tool": "mc.client.keyboard.press",
      "args": {
        "key": "key.mouse.right"
      },
      "expect": {
        "result.status": "pressed",
        "result.key": "key.mouse.right"
      }
    },
    {
      "id": "wait_for_mount_packet_roundtrip",
      "tool": "mc.client.ticks.wait",
      "args": {
        "ticks": 10
      },
      "expect": {
        "result.waitedTicks": 10
      }
    },
    {
      "id": "mounted_the_actual_oak_boat",
      "tool": "mc.client.vehicle.state",
      "args": {},
      "expect": {
        "result.inWorld": true,
        "result.isPassenger": true,
        "result.vehicle": "minecraft:oak_boat"
      }
    },
    {
      "id": "move_boat_with_real_forward_key",
      "tool": "mc.client.keyboard.hold",
      "args": {
        "key": "W",
        "ticks": 20
      },
      "expect": {
        "result.status": "held",
        "result.key": "W",
        "result.ticks": 20
      }
    },
    {
      "id": "wait_for_boat_movement_sync",
      "tool": "mc.client.ticks.wait",
      "args": {
        "ticks": 10
      },
      "expect": {
        "result.waitedTicks": 10
      }
    },
    {
      "id": "still_mounted_after_real_movement",
      "tool": "mc.client.vehicle.state",
      "args": {},
      "expect": {
        "result.inWorld": true,
        "result.isPassenger": true,
        "result.vehicle": "minecraft:oak_boat"
      }
    },
    {
      "id": "observe_authoritative_boat_after_real_movement",
      "tool": "mc.remote.call",
      "args": {
        "tool": "mc.server.entity.query",
        "arguments": {
          "type": "minecraft:oak_boat",
          "from": {
            "x": 30,
            "y": 79,
            "z": 30
          },
          "to": {
            "x": 38,
            "y": 84,
            "z": 42
          },
          "limit": 4
        },
        "timeoutMs": 30000
      },
      "expect": {
        "result.type": "minecraft:oak_boat",
        "result.total": 1,
        "result.returned": 1
      }
    }
  ]
}
