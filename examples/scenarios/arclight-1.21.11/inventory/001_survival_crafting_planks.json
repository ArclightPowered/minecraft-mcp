{
  "name": "Arclight 1.21.11 survival crafting table planks",
  "tags": ["arclight-1.21.11", "external-server", "inventory", "container", "crafting", "survival", "requires-op", "full-client", "remote-mcp"],
  "requires": {"loaders": ["fabric", "neoforge"]},
  "notes": [
    "Prerequisite: connect the client, then run entities/000_connect_remote_arclight.json.",
    "The connected test player must be named McpProbe. Fixture commands deliberately target @a[name=McpProbe], never server-command @s.",
    "The target chunk is force-loaded before construction, but client block reads occur only after the player is teleported onto the completed platform so the client chunk is loaded."
  ],
  "steps": [
    {"id":"assert_playable_world","tool":"mc.client.condition.wait","args":{"condition":"client.inWorld == true && client.screen == null","timeoutMs":30000},"expect":{"result.matched":true}},
    {"id":"confirm_remote_server_mcp","tool":"mc.remote.call","args":{"tool":"mc.server.state","arguments":{},"timeoutMs":30000},"expect":{"result.running":true,"result.dedicated":true}},
    {"id":"remove_fixture_forceload","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"forceload remove 10 -1 12 1"},"timeoutMs":30000}},
    {"id":"forceload_fixture_chunk","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"forceload add 10 -1 12 1"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"forceload add 10 -1 12 1","result.success":true,"result.completed":true}},
    {"id":"fixture_chunk_authoritatively_loaded","tool":"mc.remote.call","args":{"tool":"mc.server.chunk.state","arguments":{"dimension":"minecraft:overworld","chunkX":0,"chunkZ":-1},"timeoutMs":30000},"expect":{"result.loaded":true,"result.present":true}},
    {"id":"fixture_chunk_authoritatively_loaded_second","tool":"mc.remote.call","args":{"tool":"mc.server.chunk.state","arguments":{"dimension":"minecraft:overworld","chunkX":0,"chunkZ":0},"timeoutMs":30000},"expect":{"result.loaded":true,"result.present":true}},
    {"id":"seed_clear_volume_marker","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"setblock 10 83 1 minecraft:stone"},"timeoutMs":30000}},
    {"id":"clear_test_volume","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"fill 10 79 -1 12 83 1 minecraft:air"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"fill 10 79 -1 12 83 1 minecraft:air","result.success":true,"result.completed":true}},
    {"id":"place_safe_platform","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"fill 10 79 -1 12 79 1 minecraft:stone"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"fill 10 79 -1 12 79 1 minecraft:stone","result.success":true,"result.completed":true}},
    {"id":"place_crafting_table","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"setblock 11 80 0 minecraft:crafting_table"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"setblock 11 80 0 minecraft:crafting_table","result.success":true,"result.completed":true}},
    {"id":"teleport_probe_to_completed_platform","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"tp @a[name=McpProbe] 10 80 0"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"tp @a[name=McpProbe] 10 80 0","result.success":true,"result.completed":true}},
    {"id":"sync_after_teleport","tool":"mc.client.connection.sync","args":{"timeoutMs":30000},"expect":{"result.status":"synced"}},
    {"id":"wait_for_client_chunk","tool":"mc.client.ticks.wait","args":{"ticks":10},"expect":{"result.waitedTicks":10}},
    {"id":"client_floor_confirmed_after_tp","tool":"mc.client.block.state","args":{"x":10,"y":79,"z":0},"expect":{"result.inWorld":true,"result.block":"minecraft:stone"}},
    {"id":"client_crafting_table_confirmed_after_tp","tool":"mc.client.block.state","args":{"x":11,"y":80,"z":0},"expect":{"result.inWorld":true,"result.block":"minecraft:crafting_table"}},
    {"id":"seed_clear_inventory_marker","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"item replace entity @a[name=McpProbe] hotbar.8 with minecraft:stick 1"},"timeoutMs":30000}},
    {"id":"clear_probe_inventory","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"clear @a[name=McpProbe]"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"clear @a[name=McpProbe]","result.success":true,"result.completed":true}},
    {"id":"put_log_in_probe_hotbar_zero","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"item replace entity @a[name=McpProbe] hotbar.0 with minecraft:oak_log 1"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"item replace entity @a[name=McpProbe] hotbar.0 with minecraft:oak_log 1","result.success":true,"result.completed":true}},
    {"id":"ensure_probe_creative_before_survival","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"execute unless entity @a[name=McpProbe,gamemode=creative] run gamemode creative @a[name=McpProbe]"},"timeoutMs":30000}},
    {"id":"set_probe_survival","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"gamemode survival @a[name=McpProbe]"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"gamemode survival @a[name=McpProbe]","result.success":true,"result.completed":true}},
    {"id":"probe_survival_authoritatively_confirmed","tool":"mc.remote.call","args":{"tool":"mc.server.player.state","arguments":{"player":"McpProbe"},"timeoutMs":30000},"expect":{"result.gameMode":"survival"}},
    {"id":"sync_before_open_table","tool":"mc.client.connection.sync","args":{"timeoutMs":30000},"expect":{"result.status":"synced"}},
    {"id":"wait_for_inventory_update","tool":"mc.client.ticks.wait","args":{"ticks":5},"expect":{"result.waitedTicks":5}},
    {"id":"open_crafting_table","tool":"mc.client.block.interact","args":{"x":11,"y":80,"z":0,"face":"up","hand":"main"},"expect":{"result.status":"interacted","result.consumesAction":true}},
    {"id":"wait_open","tool":"mc.client.ticks.wait","args":{"ticks":2},"expect":{"result.waitedTicks":2}},
    {"id":"crafting_menu_and_input_confirmed","tool":"mc.client.container.state","args":{},"expect":{"result.hasContainer":true,"result.hasScreen":true,"result.menuType":"minecraft:crafting","result.slots.37.item":"minecraft:oak_log","result.slots.37.count":1}},
    {"id":"pick_log_from_hotbar","tool":"mc.client.container.click","args":{"slot":37,"button":0,"clickType":"PICKUP"},"expect":{"result.status":"clicked","result.slot":37,"result.clickType":"PICKUP"}},
    {"id":"place_log_in_grid","tool":"mc.client.container.click","args":{"slot":1,"button":0,"clickType":"PICKUP"},"expect":{"result.status":"clicked","result.slot":1,"result.clickType":"PICKUP"}},
    {"id":"wait_recipe_update","tool":"mc.client.ticks.wait","args":{"ticks":5},"expect":{"result.waitedTicks":5}},
    {"id":"recipe_output_ready","tool":"mc.client.container.state","args":{},"expect":{"result.slots.0.item":"minecraft:oak_planks","result.slots.0.count":4}},
    {"id":"quick_move_result","tool":"mc.client.container.quick_move","args":{"slot":0},"expect":{"result.status":"clicked","result.clickType":"QUICK_MOVE","result.slot":0}},
    {"id":"find_planks","tool":"mc.client.inventory.find","args":{"item":"minecraft:oak_planks"},"expect":{"result.found":true,"result.totalCount":4}},
    {"id":"close_container","tool":"mc.client.container.close","args":{},"expect":{"result.status":"closed"}}
  ]
}
