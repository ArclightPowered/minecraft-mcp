{
  "name": "Arclight 1.21.11 survival furnace smelts iron",
  "tags": ["arclight-1.21.11", "external-server", "inventory", "container", "furnace", "survival", "requires-op", "full-client", "remote-mcp"],
  "requires": {"loaders": ["fabric", "neoforge"]},
  "notes": [
    "Prerequisite: connect the client, then run entities/000_connect_remote_arclight.json.",
    "The connected test player must be named McpProbe. Fixture commands deliberately target @a[name=McpProbe], never server-command @s.",
    "The target chunk is force-loaded before construction, but client block reads occur only after the player is teleported onto the completed platform so the client chunk is loaded.",
    "The smelt wait is mc.server.ticks.wait through mc.remote.call, so it observes real server ticks rather than local wall-clock sleep."
  ],
  "steps": [
    {"id":"assert_playable_world","tool":"mc.client.condition.wait","args":{"condition":"client.inWorld == true && client.screen == null","timeoutMs":30000},"expect":{"result.matched":true}},
    {"id":"confirm_remote_server_mcp","tool":"mc.remote.call","args":{"tool":"mc.server.state","arguments":{},"timeoutMs":30000},"expect":{"result.running":true,"result.dedicated":true}},
    {"id":"remove_fixture_forceload","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"forceload remove 20 -1 22 1"},"timeoutMs":30000}},
    {"id":"forceload_fixture_chunk","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"forceload add 20 -1 22 1"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"forceload add 20 -1 22 1","result.success":true,"result.completed":true}},
    {"id":"fixture_chunk_authoritatively_loaded","tool":"mc.remote.call","args":{"tool":"mc.server.chunk.state","arguments":{"dimension":"minecraft:overworld","chunkX":1,"chunkZ":-1},"timeoutMs":30000},"expect":{"result.loaded":true,"result.present":true}},
    {"id":"fixture_chunk_authoritatively_loaded_second","tool":"mc.remote.call","args":{"tool":"mc.server.chunk.state","arguments":{"dimension":"minecraft:overworld","chunkX":1,"chunkZ":0},"timeoutMs":30000},"expect":{"result.loaded":true,"result.present":true}},
    {"id":"seed_clear_volume_marker","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"setblock 20 83 1 minecraft:stone"},"timeoutMs":30000}},
    {"id":"clear_test_volume","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"fill 20 79 -1 22 83 1 minecraft:air"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"fill 20 79 -1 22 83 1 minecraft:air","result.success":true,"result.completed":true}},
    {"id":"place_safe_platform","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"fill 20 79 -1 22 79 1 minecraft:stone"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"fill 20 79 -1 22 79 1 minecraft:stone","result.success":true,"result.completed":true}},
    {"id":"place_furnace","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"setblock 21 80 0 minecraft:furnace"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"setblock 21 80 0 minecraft:furnace","result.success":true,"result.completed":true}},
    {"id":"teleport_probe_to_completed_platform","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"tp @a[name=McpProbe] 20 80 0"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"tp @a[name=McpProbe] 20 80 0","result.success":true,"result.completed":true}},
    {"id":"sync_after_teleport","tool":"mc.client.connection.sync","args":{"timeoutMs":30000},"expect":{"result.status":"synced"}},
    {"id":"wait_for_client_chunk","tool":"mc.client.ticks.wait","args":{"ticks":10},"expect":{"result.waitedTicks":10}},
    {"id":"client_floor_confirmed_after_tp","tool":"mc.client.block.state","args":{"x":20,"y":79,"z":0},"expect":{"result.inWorld":true,"result.block":"minecraft:stone"}},
    {"id":"client_furnace_confirmed_after_tp","tool":"mc.client.block.state","args":{"x":21,"y":80,"z":0},"expect":{"result.inWorld":true,"result.block":"minecraft:furnace"}},
    {"id":"seed_clear_inventory_marker","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"item replace entity @a[name=McpProbe] hotbar.8 with minecraft:stick 1"},"timeoutMs":30000}},
    {"id":"clear_probe_inventory","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"clear @a[name=McpProbe]"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"clear @a[name=McpProbe]","result.success":true,"result.completed":true}},
    {"id":"put_raw_iron_in_probe_hotbar_zero","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"item replace entity @a[name=McpProbe] hotbar.0 with minecraft:raw_iron 1"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"item replace entity @a[name=McpProbe] hotbar.0 with minecraft:raw_iron 1","result.success":true,"result.completed":true}},
    {"id":"put_coal_in_probe_hotbar_one","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"item replace entity @a[name=McpProbe] hotbar.1 with minecraft:coal 1"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"item replace entity @a[name=McpProbe] hotbar.1 with minecraft:coal 1","result.success":true,"result.completed":true}},
    {"id":"ensure_probe_creative_before_survival","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"execute unless entity @a[name=McpProbe,gamemode=creative] run gamemode creative @a[name=McpProbe]"},"timeoutMs":30000}},
    {"id":"set_probe_survival","tool":"mc.remote.call","args":{"tool":"mc.server.command.run","arguments":{"command":"gamemode survival @a[name=McpProbe]"},"timeoutMs":30000},"expect":{"result.status":"succeeded","result.command":"gamemode survival @a[name=McpProbe]","result.success":true,"result.completed":true}},
    {"id":"probe_survival_authoritatively_confirmed","tool":"mc.remote.call","args":{"tool":"mc.server.player.state","arguments":{"player":"McpProbe"},"timeoutMs":30000},"expect":{"result.gameMode":"survival"}},
    {"id":"sync_before_open_furnace","tool":"mc.client.connection.sync","args":{"timeoutMs":30000},"expect":{"result.status":"synced"}},
    {"id":"wait_for_inventory_update","tool":"mc.client.ticks.wait","args":{"ticks":5},"expect":{"result.waitedTicks":5}},
    {"id":"probe_hotbar_fixture_confirmed","tool":"mc.client.inventory.state","args":{},"expect":{"result.hotbar.0.item":"minecraft:raw_iron","result.hotbar.0.count":1,"result.hotbar.1.item":"minecraft:coal","result.hotbar.1.count":1,"result.hotbar.8.item":"minecraft:air","result.hotbar.8.count":0,"result.hotbar.8.empty":true}},
    {"id":"select_empty_hand","tool":"mc.client.hotbar.select","args":{"slot":8},"expect":{"result.status":"selected","result.slot":8,"result.item.item":"minecraft:air","result.item.count":0,"result.item.empty":true}},
    {"id":"open_furnace","tool":"mc.client.block.interact","args":{"x":21,"y":80,"z":0,"face":"up","hand":"main"},"expect":{"result.status":"interacted"}},
    {"id":"wait_open","tool":"mc.client.ticks.wait","args":{"ticks":2},"expect":{"result.waitedTicks":2}},
    {"id":"furnace_menu_and_inputs_confirmed","tool":"mc.client.container.state","args":{},"expect":{"result.hasContainer":true,"result.hasScreen":true,"result.menuType":"minecraft:furnace","result.slots.30.item":"minecraft:raw_iron","result.slots.30.count":1,"result.slots.31.item":"minecraft:coal","result.slots.31.count":1}},
    {"id":"pick_raw_iron","tool":"mc.client.container.click","args":{"slot":30,"button":0,"clickType":"PICKUP"},"expect":{"result.status":"clicked","result.slot":30,"result.clickType":"PICKUP"}},
    {"id":"place_raw_iron_input","tool":"mc.client.container.click","args":{"slot":0,"button":0,"clickType":"PICKUP"},"expect":{"result.status":"clicked","result.slot":0,"result.clickType":"PICKUP"}},
    {"id":"pick_coal","tool":"mc.client.container.click","args":{"slot":31,"button":0,"clickType":"PICKUP"},"expect":{"result.status":"clicked","result.slot":31,"result.clickType":"PICKUP"}},
    {"id":"place_coal_fuel","tool":"mc.client.container.click","args":{"slot":1,"button":0,"clickType":"PICKUP"},"expect":{"result.status":"clicked","result.slot":1,"result.clickType":"PICKUP"}},
    {"id":"furnace_inputs_placed","tool":"mc.client.container.state","args":{},"expect":{"result.slots.0.item":"minecraft:raw_iron","result.slots.0.count":1,"result.slots.1.item":"minecraft:coal","result.slots.1.count":1}},
    {"id":"wait_smelt_real_server_ticks","tool":"mc.remote.call","args":{"tool":"mc.server.ticks.wait","arguments":{"ticks":220},"timeoutMs":120000},"expect":{"result.requestedTicks":220,"result.waitedTicks":220,"result.complete":true}},
    {"id":"output_ready","tool":"mc.client.container.state","args":{},"expect":{"result.slots.2.item":"minecraft:iron_ingot","result.slots.2.count":1}},
    {"id":"take_result","tool":"mc.client.container.quick_move","args":{"slot":2},"expect":{"result.status":"clicked","result.clickType":"QUICK_MOVE","result.slot":2}},
    {"id":"find_ingot","tool":"mc.client.inventory.find","args":{"item":"minecraft:iron_ingot"},"expect":{"result.found":true,"result.totalCount":1}},
    {"id":"close_container","tool":"mc.client.container.close","args":{},"expect":{"result.status":"closed"}}
  ]
}
