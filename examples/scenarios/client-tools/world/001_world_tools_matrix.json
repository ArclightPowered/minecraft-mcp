{"name":"client_world_tools_matrix","tags":["world","client-tools"],"requires":{"loaders":["fabric","neoforge"]},"steps":[{"id":"create","tool":"mc.world.create_test_world","args":{"name":"minecraft_mcp_client_tools_matrix","seed":4242},"expect":{"result.status":"created"}},{"id":"wait_world","tool":"mc.wait_until","args":{"condition":"client.inWorld == true","timeoutMs":120000},"expect":{"result.matched":true}},{"id":"screen_snapshot_loading_or_ready","tool":"mc.get_screen_state","args":{}},{"id":"wait_no_screen","tool":"mc.wait_until","args":{"condition":"client.screen == null","timeoutMs":30000},"expect":{"result.matched":true}},{"id":"screen_none","tool":"mc.get_screen_state","args":{},"expect":{"result.hasScreen":false}},{"id":"chat","tool":"mc.chat.send","args":{"message":"minecraft-mcp scenario chat"},"expect":{"result.status":"sent","result.kind":"chat"}},{"id":"chat_command","tool":"mc.chat.send","args":{"message":"/say minecraft-mcp command chat"},"expect":{"result.status":"sent","result.kind":"command"}},{"id":"interact_pass","tool":"mc.interact.block","args":{"x":0,"y":63,"z":0,"face":"up","hand":"main"},"expect":{"result.status":"interacted"}},{"id":"interact_invalid_face","tool":"mc.interact.block","args":{"x":0,"y":63,"z":0,"face":"bad_face","hand":"main"},"expect":{"result.status":"rejected","result.reason":"invalid face"}},{"id":"disconnect_state","tool":"mc.server.get_disconnect_state","args":{},"expect":{"result.disconnected":false}},{"id":"leave","tool":"mc.world.leave_to_title","args":{},"expect":{"result.status":"left_to_title"}}]}
