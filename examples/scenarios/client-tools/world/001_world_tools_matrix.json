{"name":"client_world_tools_matrix","tags":["world","client-tools"],"requires":{"loaders":["fabric","neoforge"]},"steps":[{"id":"create","tool":"mc.client.world.join","args":{"name":"minecraft_mcp_client_tools_matrix","seed":4242},"expect":{"result.status":"joining"}},{"id":"wait_world","tool":"mc.client.condition.wait","args":{"condition":"client.inWorld == true","timeoutMs":120000},"expect":{"result.matched":true}},{"id":"screen_snapshot_loading_or_ready","tool":"mc.client.screen.state","args":{}},{"id":"wait_no_screen","tool":"mc.client.condition.wait","args":{"condition":"client.screen == null","timeoutMs":30000},"expect":{"result.matched":true}},{"id":"screen_none","tool":"mc.client.screen.state","args":{},"expect":{"result.hasScreen":false}},{"id":"chat","tool":"mc.client.chat.send","args":{"message":"minecraft-mcp scenario chat"},"expect":{"result.status":"sent","result.kind":"chat"}},{"id":"chat_command","tool":"mc.client.chat.send","args":{"message":"/say minecraft-mcp command chat"},"expect":{"result.status":"sent","result.kind":"command"}},{"id":"interact_pass","tool":"mc.client.block.interact","args":{"x":0,"y":63,"z":0,"face":"up","hand":"main"},"expect":{"result.status":"interacted"}},{"id":"interact_invalid_face","tool":"mc.client.block.interact","args":{"x":0,"y":63,"z":0,"face":"bad_face","hand":"main"},"expect":{"result.status":"rejected","result.reason":"invalid face"}},{"id":"disconnect_state","tool":"mc.client.connection.state","args":{},"expect":{"result.disconnected":false}},{"id":"leave","tool":"mc.client.world.leave","args":{},"expect":{"result.status":"left_to_title"}}]}
