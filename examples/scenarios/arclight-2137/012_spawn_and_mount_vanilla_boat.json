{"name":"arclight_2137_spawn_and_mount_vanilla_boat","tags":["arclight-2137","vehicle","mount","world","full-client","requires-command-permission"],"steps":[{"id":"clear_boat","tool":"mc.command.run","args":{"command":"kill @e[type=minecraft:oak_boat,distance=..8]"},"expect":{"result.status":"sent"}},{"id":"summon_boat","tool":"mc.command.run","args":{"command":"summon minecraft:oak_boat ~ ~ ~ {Tags:[\"minecraft_mcp_2137_vehicle\"]}"},"expect":{"result.status":"sent"}},{"id":"wait_spawn","tool":"mc.ticks.wait","args":{"ticks":10},"expect":{"result.waitedTicks":10}},{"id":"mount_boat","tool":"mc.command.run","args":{"command":"ride @p mount @e[type=minecraft:oak_boat,tag=minecraft_mcp_2137_vehicle,limit=1,sort=nearest]"},"expect":{"result.status":"sent"}},{"id":"wait_mount","tool":"mc.condition.wait","args":{"condition":"vehicle.isPassenger == true","timeoutMs":10000},"expect":{"result.matched":true}},{"id":"vehicle","tool":"mc.vehicle.state","args":{},"expect":{"result.isPassenger":true,"result.vehicle":{"contains":"minecraft:"}}}]}
