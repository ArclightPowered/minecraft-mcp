{
  "name": "move waypoint loop smoke",
  "tags": [
    "world",
    "movement",
    "manual"
  ],
  "steps": [
    {
      "tool": "mc.movement.waypoints",
      "expect": {
        "result.status": "completed",
        "result.sneak": false
