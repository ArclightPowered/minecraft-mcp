{
  "name": "packet create test world",
  "tags": ["packet", "world"],
  "steps": [
    {
      "tool": "mc.world.join",
      "args": {
        "name": "minecraft_mcp_packet_world",
        "seed": 0,
        "allowCommands": true
      },
      "expect": {
        "result.status": "joining"
      }
    },
    {
      "tool": "mc.ticks.wait",
      "args": {
        "ticks": 120
      }
    },
    {
      "tool": "mc.condition.wait",
      "args": {
        "condition": "client.inWorld == true",
        "timeoutMs": 60000
      },
      "expect": {
        "result.matched": true
      }
    }
  ]
}
